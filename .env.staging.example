# Isolated staging. Copy values locally. Never commit secrets.
# For a dedicated private-testing host use APP_ENVIRONMENT=private-beta.
# Never claim production from staging or private-beta.
NODE_ENV=development
APP_ENVIRONMENT=staging
DEV_MODE=false
PORT=4100
DATABASE_URL=postgresql://supreme_staging:supreme_staging@127.0.0.1:55434/supreme_risk_staging
JWT_SECRET=staging-jwt-secret-key-which-is-long-enough-32
JWT_REFRESH_SECRET=staging-refresh-secret-key-which-is-long-enough
JWT_EXPIRES_IN=15m
CORS_ORIGIN=http://127.0.0.1:3200
FRONTEND_URL=http://127.0.0.1:3200
APP_BASE_URL=http://127.0.0.1:4100
REDIS_URL=redis://127.0.0.1:6382
S3_BUCKET=supreme-risk-staging
S3_ENDPOINT=http://127.0.0.1:9000
S3_FORCE_PATH_STYLE=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=stagingminio
AWS_SECRET_ACCESS_KEY=stagingminio123
ALLOW_LOCAL_OBJECT_STORAGE=false
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM_EMAIL=noreply@staging.supremerisk.local
ALLOW_PENDING_DOWNLOADS=false
ALLOW_UNSCANNED_DOWNLOADS=false
OPENAI_API_KEY=
AI_API_KEY=
# Stripe TEST MODE only. Live keys (sk_live_) are rejected at runtime.
# Required for billing PASS:
#   STRIPE_SECRET_KEY=sk_test_...
#   STRIPE_WEBHOOK_SECRET=whsec_...
#   STRIPE_PRICE_STARTER=price_...
#   STRIPE_PRICE_PROFESSIONAL=price_...
#   STRIPE_PRICE_ENTERPRISE=price_...
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_PROFESSIONAL_ANNUAL=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_BUSINESS_ANNUAL=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PRICE_ENTERPRISE_ANNUAL=
CLAMAV_HOST=
CLAMAV_PORT=3310
ALERT_WEBHOOK_URL=
DEMO_INQUIRY_EMAIL=
MONGODB_URI=
VITE_ENVIRONMENT=staging
VITE_API_URL=http://127.0.0.1:4100/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:4100
VITE_PREVIEW_LABEL=false
