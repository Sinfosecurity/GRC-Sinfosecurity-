# Copy locally as .env.hosted-staging.local. Never commit secrets.
# Public staging URLs are assigned by Render.

VITE_ENVIRONMENT=staging
VITE_API_URL=https://supreme-risk-staging-api.onrender.com/api/v1
APP_ENVIRONMENT=staging
DEV_MODE=false
NODE_ENV=production

# Set these in the Render dashboard, not in git:
# DATABASE_URL
# REDIS_URL
# JWT_SECRET
# JWT_REFRESH_SECRET
# AWS_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY
# S3_BUCKET=supreme-risk-staging
# S3_ENDPOINT
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=resend
# SMTP_PASSWORD=
# SMTP_FROM_NAME=Supreme Risk
# FRONTEND_BASE_URL=https://supreme-risk-staging.onrender.com
# FRONTEND_URL=https://supreme-risk-staging.onrender.com
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs live in the host environment only. Do not hard-code a catalog here.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_STARTER_ANNUAL=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_PROFESSIONAL_ANNUAL=
STRIPE_PRICE_ENTERPRISE=
STRIPE_PRICE_ENTERPRISE_ANNUAL=
# CLAMAV_HOST=
# CLAMAV_PORT=3310
# ALERT_WEBHOOK_URL
# ALERT_EMAIL_TO
# SMTP_FROM_EMAIL=
