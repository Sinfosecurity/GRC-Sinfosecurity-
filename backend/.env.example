# Supreme Risk backend — names and safe descriptions only.
# Copy to .env. Never commit real values.

NODE_ENV=development
PORT=4000
API_VERSION=v1
# DEV_MODE skips optional Redis/Mongo only. It is never an authentication path.
# Forbidden when NODE_ENV=production.
DEV_MODE=false

CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
APP_BASE_URL=http://localhost:4000

# Required. Production refuses weak or placeholder values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
JWT_SECRET=generate-a-random-64-byte-hex-string
JWT_REFRESH_SECRET=generate-a-different-random-64-byte-hex-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Optional cache/queue
REDIS_URL=redis://localhost:6379

# Object storage. Without S3 credentials, production reports NOT_CONFIGURED
# unless ALLOW_LOCAL_OBJECT_STORAGE=true (local disk only).
S3_BUCKET=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
ALLOW_LOCAL_OBJECT_STORAGE=true
ENCRYPTION_KEY=
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Email. Unset = NOT_CONFIGURED
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Supreme Risk
FRONTEND_BASE_URL=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@example.com
# Optional inbox for landing-page demo requests. Unset = store locally, delivery NOT_CONFIGURED.
DEMO_INQUIRY_EMAIL=

# Billing. Unset = NOT_CONFIGURED
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_ENTERPRISE=

# AI. Unset = NOT_CONFIGURED. AI never owns risk scores.
OPENAI_API_KEY=
AI_API_KEY=
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_SERVICE_URL=

# Integrations. Unset = NOT_CONFIGURED
SLACK_WEBHOOK_URL=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
SERVICENOW_INSTANCE=
SERVICENOW_USER=
SERVICENOW_PASSWORD=
SIEM_WEBHOOK_URL=
SIEM_TOKEN=

# Malware scanning. Unset = scan status NOT_CONFIGURED (never CLEAN)
MALWARE_SCAN_PROVIDER=
CLAMAV_HOST=
