// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Users and Authentication
model User {
  id             String            @id @default(uuid())
  email          String            @unique
  hashedPassword String
  firstName      String
  lastName       String
  role           Role              @default(USER)
  organization   Organization      @relation(fields: [organizationId], references: [id])
  organizationId String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  lastLogin      DateTime?

  status            UserAccountStatus @default(ACTIVE)
  disabledAt        DateTime?
  emailVerifiedAt   DateTime?
  passwordChangedAt DateTime?
  mfaEnabled        Boolean           @default(false)
  mfaSecretEnc      String?
  mfaEnrolledAt     DateTime?
  lastMfaVerifiedAt DateTime?
  mfaLastCounter    Int?
  sessionEpoch          Int       @default(0)
  provisioningSource    String?
  lastSsoAt             DateTime?

  risks               Risk[]
  incidents           Incident[]
  policies            Policy[]
  audits              AuditLog[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  sentInvitations     AccountInvitation[]  @relation("InvitedBy")
  auditEvents         AuditEvent[]
  supportTicketsRequested SupportTicket[] @relation("TicketRequester")
  supportTicketsAssigned  SupportTicket[] @relation("TicketAssignee")
  supportMessages         SupportTicketMessage[]
  sessionsRequested       SupportAccessSession[] @relation("SessionRequested")
  sessionsApproved        SupportAccessSession[] @relation("SessionApproved")
  sessionsCustomerApproved SupportAccessSession[] @relation("SessionCustomerApproved")
  incidentsOwned          PlatformIncident[] @relation("IncidentOwner")
  mfaRecoveryCodes        MfaRecoveryCode[]
  privilegeElevations     PrivilegeElevation[]
  authChallenges          AuthChallenge[]
  identityAccounts        IdentityExternalAccount[]
  identityBreakGlassGrants IdentityBreakGlassGrant[]
  recoveredIdentityProviders IdentityProvider[] @relation("IdentityRecoveryAdmin")
  scimGroupMembers        ScimGroupMember[]

  @@index([email])
  @@index([organizationId])
  @@index([status])
}

enum UserAccountStatus {
  ACTIVE
  DISABLED
  PENDING_ACTIVATION
}

enum Role {
  SUPERADMIN
  ADMIN
  COMPLIANCE_OFFICER
  RISK_MANAGER
  AUDITOR
  USER
  PLATFORM_ADMIN
  ORGANIZATION_ADMIN
  ASSESSOR
  APPROVER
  BUSINESS_OWNER
  VIEWER
  PLATFORM_OWNER
  SUPPORT_ADMIN
  SUPPORT_ANALYST
  BILLING_SUPPORT
  SECURITY_ADMIN
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  industry    String?
  country     String
  size        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  slug               String?             @unique
  status             OrganizationStatus  @default(TRIAL)
  plan               String              @default("STARTER")
  trialStart         DateTime?
  trialEnd           DateTime?
  subscriptionStatus    String?
  billingCustomerId     String?
  billingSubscriptionId String?
  billingInterval       String?
  cancelAtPeriodEnd     Boolean @default(false)
  isDemo             Boolean             @default(false)
  timezone           String              @default("UTC")
  legalName          String?
  contactName        String?
  contactEmail       String?
  contactPhone       String?

  users                       User[]
  invitations                 AccountInvitation[]
  auditEvents                 AuditEvent[]
  storedObjects               StoredObject[]
  questionnaireTemplates      QuestionnaireTemplate[]
  inAppNotifications          InAppNotification[]
  notificationPreferences     NotificationPreference[]
  integrationConnections      IntegrationConnection[]
  aiOperationLogs             AiOperationLog[]
  scoreCalculations           ScoreCalculation[]
  riskDecisionBriefs          RiskDecisionBrief[]
  evidenceLinks               EvidenceLink[]
  scoringMethodologies        ScoringMethodology[]
  subscriptionEvents          SubscriptionEvent[]
  supportTickets              SupportTicket[]
  incidentLinks               PlatformIncidentOrg[]
  supportSessions             SupportAccessSession[]
  notificationDeliveries      NotificationDeliveryLog[]
  operationalEvents           OperationalEvent[]
  governanceNodes             GovernanceNode[]
  governanceEdges             GovernanceEdge[]
  organizationControls        OrganizationControl[]
  organizationControlTests    OrganizationControlTest[]
  requirementControlMappings  RequirementControlMapping[]
  evidenceGovernanceLinks     EvidenceGovernanceLink[]
  businessUnits               BusinessUnit[]
  enterpriseRisks             EnterpriseRisk[]
  enterpriseRiskAppetites     EnterpriseRiskAppetite[]
  enterpriseRiskMethodologies EnterpriseRiskMethodology[]
  enterpriseRiskKris          EnterpriseRiskKri[]
  enterpriseRiskCategories    EnterpriseRiskCustomCategory[]
  complianceActivations       ComplianceActivation[]
  complianceRequirementStates ComplianceRequirementState[]
  complianceCampaigns         ComplianceAttestationCampaign[]
  complianceAttestations      ComplianceAttestation[]
  complianceGaps              ComplianceGap[]
  complianceExceptions        ComplianceException[]
  compliancePeriods           CompliancePeriod[]
  complianceHistory           ComplianceHistory[]
  privacyActivities           PrivacyProcessingActivity[]
  privacyTransfers            PrivacyTransfer[]
  privacyDpias                PrivacyDpia[]
  privacyRightsRequests       PrivacyRightsRequest[]
  privacyRetentionRules       PrivacyRetentionRule[]
  privacyHistory              PrivacyHistory[]
  aiSystems                   AiSystem[]
  aiUseCases                  AiUseCase[]
  aiModelProviders            AiModelProvider[]
  aiHistory                   AiHistory[]
  intelligenceItems           IntelligenceItem[]
  intelligenceHistory         IntelligenceHistory[]
  automations                 AutomationDefinition[]
  automationVersions          AutomationVersion[]
  automationExecutions        AutomationExecution[]
  automationWorkItems         AutomationWorkItem[]
  risks                       Risk[]
  controls                    Control[]
  incidents                   Incident[]
  policies                    Policy[]
  compliance                  ComplianceFramework[]
  vendors                     Vendor[]
  vendorOnboardings           VendorOnboarding[]
  vendorAssessmentInvitations VendorAssessmentInvitation[]
  requesterTaskLinks          RequesterTaskLink[]
  vendorPortalSessions        VendorPortalSession[]
  vendorAssessments           VendorAssessment[]
  vendorContracts             VendorContract[]
  vendorIssues                VendorIssue[]
  vendorDocuments             VendorDocument[]
  vendorMonitoring            VendorMonitoring[]
  vendorReviews               VendorReview[]
  
  // Enterprise Audit & Compliance Relations
  vendorApprovalWorkflows     VendorApprovalWorkflow[]
  vendorDueDiligenceScopes    VendorDueDiligenceScope[]
  vendorRiskControls          VendorRiskControl[]
  vendorIssueRCAs             VendorIssueRCA[]
  vendorIssueEscalations      VendorIssueEscalation[]
  vendorRiskHistory           VendorRiskHistory[]
  vendorDocumentAlerts        VendorDocumentAlert[]
  managementAttestations      ManagementAttestation[]
  vendorExceptions            VendorException[]
  vendorSOCScopes             VendorSOCScope[]
  fourthParties               FourthParty[]
  vendorExitRiskAssessments   VendorExitRiskAssessment[]
  vendorExitClosures          VendorExitClosure[]
  riskAppetites               RiskAppetite[]
  businessProcessMappings     BusinessProcessVendorMapping[]
  vendorBAAs                  VendorBAA[]
  vendorISOControlMappings    VendorISOControlMapping[]
  identityProviders           IdentityProvider[]
  identityDomains             IdentityDomain[]
  identityRoleMappings        IdentityRoleMapping[]
  identityExternalAccounts    IdentityExternalAccount[]
  identityLoginStates         SsoLoginState[]
  identityReplayRecords       SsoReplayRecord[]
  scimTokens                  ScimToken[]
  scimGroups                  ScimGroup[]
  scimGroupMembers            ScimGroupMember[]
  identityBreakGlassGrants    IdentityBreakGlassGrant[]
  publicApiClients            PublicApiClient[]
  webhookEndpoints            WebhookEndpoint[]
  webhookDeliveries           WebhookDelivery[]
  webhookSinkReceipts         WebhookSinkReceipt[]
  idempotencyRecords          IdempotencyRecord[]
  externalResourceLinks       ExternalResourceLink[]
  providerObservations        ProviderObservation[]
  editionConfigs              OrganizationEditionConfig[]
  insuranceEntities           InsuranceEntity[]
  insuranceLicenses           InsuranceLicense[]
  insuranceVendorClasses      InsuranceVendorClassification[]
  insuranceAiContexts         InsuranceAiContext[]
  insuranceApplicability      InsuranceApplicabilityDecision[]
  insuranceDelegatedAuthority InsuranceDelegatedAuthority[]
  insuranceCounterparties     InsuranceCounterparty[]
  intakeRequests              IntakeRequest[]
  intakeAssignments           IntakeAssignment[]
  intakeInformationRequests   IntakeInformationRequest[]
  engagements                 Engagement[]
  engagementIras              EngagementIra[]
  engagementIraSubmissions    EngagementIraSubmission[]
  engagementIraClarifications EngagementIraClarification[]
  engagementDueDiligencePlans EngagementDueDiligencePlan[]
  engagementAssessmentReviews EngagementAssessmentReview[]
  engagementControlEffectiveness EngagementControlEffectiveness[]
  engagementCompensatingControls EngagementCompensatingControl[]
  engagementResidualAssessments EngagementResidualRiskAssessment[]
  engagementRiskTreatments    EngagementRiskTreatment[]
  engagementRiskAcceptances   EngagementRiskAcceptance[]
  engagementDecisionApprovals EngagementDecisionApproval[]
  engagementContractRequirements EngagementContractRequirement[]
  engagementContractExceptions EngagementContractException[]
  engagementContractGates     EngagementContractGate[]
  engagementActivations       EngagementActivation[]
  engagementMonitoringProfiles EngagementMonitoringProfile[]
  engagementMonitoringSignals EngagementMonitoringSignal[]
  monitoringSignalImpacts     MonitoringSignalEngagementImpact[]
  monitoringReviews           MonitoringReview[]
  monitoringEscalations       MonitoringEscalation[]
  reassessmentRecommendations ReassessmentRecommendation[]
  engagementReassessments     EngagementReassessment[]
  engagementReassessmentItems EngagementReassessmentItem[]

  @@index([slug])
  @@index([status])
  @@index([billingCustomerId])
  @@index([billingSubscriptionId])
}

enum OrganizationStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  SUSPENDED
  CANCELLED
}

// Risk Management
model Risk {
  id            String        @id @default(uuid())
  title         String
  description   String
  category      RiskCategory
  likelihood    Int // 1-5
  impact        Int // 1-5
  riskScore     Int // likelihood * impact
  status        RiskStatus    @default(IDENTIFIED)
  owner         User          @relation(fields: [ownerId], references: [id])
  ownerId       String
  organization  Organization  @relation(fields: [organizationId], references: [id])
  organizationId String
  mitigation    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  controls      RiskControl[]
  assessments   RiskAssessment[]
  
  @@index([organizationId])
  @@index([status])
  @@index([riskScore])
  @@index([organizationId, status])
  @@index([organizationId, riskScore])
  @@index([ownerId])
  @@index([createdAt])
  @@index([category, status])
}

enum RiskCategory {
  CYBERSECURITY
  DATA_PRIVACY
  OPERATIONAL
  FINANCIAL
  COMPLIANCE
  REPUTATIONAL
  STRATEGIC
}

enum RiskStatus {
  IDENTIFIED
  ASSESSED
  MITIGATED
  ACCEPTED
  TRANSFERRED
  CLOSED
}

model RiskAssessment {
  id          String   @id @default(uuid())
  risk        Risk     @relation(fields: [riskId], references: [id])
  riskId      String
  likelihood  Int
  impact      Int
  score       Int
  notes       String?
  assessedAt  DateTime @default(now())
  
  @@index([riskId])
}

// Controls Management
model Control {
  id            String         @id @default(uuid())
  name          String
  description   String
  type          ControlType
  category      String
  status        ControlStatus  @default(PLANNED)
  effectiveness Int? // 1-5
  organization  Organization   @relation(fields: [organizationId], references: [id])
  organizationId String
  implementedAt DateTime?
  lastTested    DateTime?
  nextTest      DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  risks         RiskControl[]
  compliance    ComplianceControl[]
  tests         ControlTest[]
  vendorRiskControls VendorRiskControl[]
  
  @@index([organizationId])
  @@index([status])
}

enum ControlType {
  PREVENTIVE
  DETECTIVE
  CORRECTIVE
  DIRECTIVE
}

enum ControlStatus {
  PLANNED
  IMPLEMENTED
  TESTING
  OPERATIONAL
  INEFFECTIVE
  RETIRED
}

model RiskControl {
  id         String   @id @default(uuid())
  risk       Risk     @relation(fields: [riskId], references: [id])
  riskId     String
  control    Control  @relation(fields: [controlId], references: [id])
  controlId  String
  assignedAt DateTime @default(now())
  
  @@unique([riskId, controlId])
  @@index([riskId])
  @@index([controlId])
}

model ControlTest {
  id          String   @id @default(uuid())
  control     Control  @relation(fields: [controlId], references: [id])
  controlId   String
  result      TestResult
  notes       String?
  testedAt    DateTime @default(now())
  
  @@index([controlId])
}

// Compliance Management
model ComplianceFramework {
  id              String              @id @default(uuid())
  name            String
  type            FrameworkType
  version         String?
  organization    Organization        @relation(fields: [organizationId], references: [id])
  organizationId  String
  score           Int?                @default(0)
  lastAssessed    DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  
  requirements    ComplianceRequirement[]
  controls        ComplianceControl[]
  gapAnalyses     GapAnalysis[]
  
  @@index([organizationId])
}

enum FrameworkType {
  GDPR
  HIPAA
  CCPA
  LGPD
  APPI
  ISO27001
  TISAX
  SOC2
  PCI_DSS
  CUSTOM
}

model ComplianceRequirement {
  id            String              @id @default(uuid())
  framework     ComplianceFramework @relation(fields: [frameworkId], references: [id])
  frameworkId   String
  code          String
  title         String
  description   String
  mandatory     Boolean             @default(true)
  status        ComplianceStatus    @default(NOT_IMPLEMENTED)
  
  controls      ComplianceControl[]
  
  @@index([frameworkId])
}

model ComplianceControl {
  id             String                @id @default(uuid())
  requirement    ComplianceRequirement @relation(fields: [requirementId], references: [id])
  requirementId  String
  control        Control               @relation(fields: [controlId], references: [id])
  controlId      String
  framework      ComplianceFramework   @relation(fields: [frameworkId], references: [id])
  frameworkId    String
  mappedAt       DateTime              @default(now())
  
  @@unique([requirementId, controlId])
  @@index([requirementId])
  @@index([controlId])
  @@index([frameworkId])
}

enum ComplianceStatus {
  NOT_IMPLEMENTED
  IN_PROGRESS
  IMPLEMENTED
  COMPLIANT
  NON_COMPLIANT
}

model GapAnalysis {
  id            String              @id @default(uuid())
  framework     ComplianceFramework @relation(fields: [frameworkId], references: [id])
  frameworkId   String
  findings      Json // Array of gap findings
  score         Int
  recommendations Json
  status        AnalysisStatus      @default(PENDING)
  analyzedAt    DateTime            @default(now())
  
  @@index([frameworkId])
  @@index([status])
}

enum AnalysisStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REVIEWED
}

// Incident Management
model Incident {
  id            String         @id @default(uuid())
  title         String
  description   String
  severity      Severity
  status        IncidentStatus @default(REPORTED)
  category      String
  reporter      User           @relation(fields: [reporterId], references: [id])
  reporterId    String
  organization  Organization   @relation(fields: [organizationId], references: [id])
  organizationId String
  rootCause     String?
  resolution    String?
  reportedAt    DateTime       @default(now())
  resolvedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  @@index([organizationId])
  @@index([status])
  @@index([severity])
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum IncidentStatus {
  REPORTED
  INVESTIGATING
  CONTAINED
  RESOLVED
  CLOSED
}

// Policy Management
model Policy {
  id            String       @id @default(uuid())
  title         String
  description   String?
  content       String
  version       String       @default("1.0")
  status        PolicyStatus @default(DRAFT)
  category      String
  owner         User         @relation(fields: [ownerId], references: [id])
  ownerId       String
  organization  Organization @relation(fields: [organizationId], references: [id])
  organizationId String
  approvedAt    DateTime?
  effectiveDate DateTime?
  reviewDate    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  
  @@index([organizationId])
  @@index([status])
}

enum PolicyStatus {
  DRAFT
  REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

// Audit Log
model AuditLog {
  id            String   @id @default(uuid())
  action        String
  entity        String
  entityId      String
  user          User     @relation(fields: [userId], references: [id])
  userId        String
  changes       Json?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime @default(now())
  
  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ==========================================
// TPRM (Third-Party Risk Management) Models
// ==========================================

// Vendor/Third-Party Inventory
model Vendor {
  id                    String              @id @default(uuid())
  publicId              String?
  name                  String
  legalName             String?
  vendorType            VendorType
  category              VendorCategory
  tier                  VendorTier
  status                VendorStatus        @default(PROPOSED)
  organization          Organization        @relation(fields: [organizationId], references: [id])
  organizationId        String
  
  // Contact Information
  primaryContact        String
  contactEmail          String
  contactPhone          String?
  website               String?
  domain                String?
  country               String?
  
  // Risk Classification
  inherentRiskScore     Int                 @default(0) // 0-100
  residualRiskScore     Int                 @default(0) // 0-100
  criticalityLevel      CriticalityLevel    @default(MEDIUM)
  
  // Business Details
  businessOwner         String?             // Internal business owner (legacy display name)
  relationshipOwner     String?             // Internal relationship manager (legacy display name)
  requesterUserId       String?
  businessOwnerUserId   String?
  relationshipOwnerUserId String?
  businessUnit          String?
  estimatedAnnualSpend  Decimal?            @db.Decimal(15, 2)
  targetStartDate       DateTime?
  servicesProvided      String              // Description of services
  contractValue         Decimal?            @db.Decimal(15, 2)
  currency              String?             @default("USD")
  
  // Data & Compliance
  dataTypesAccessed     String[]            // ["PII", "PHI", "PCI", "IP", etc.]
  geographicFootprint   String[]            // Countries where vendor operates
  regulatoryScope       String[]            // ["GDPR", "HIPAA", "SOC2", etc.]
  
  // Fourth-Party Risk
  hasSubcontractors     Boolean             @default(false)
  fourthParties         Json?               // Array of subcontractors/fourth parties
  
  // Metadata
  onboardedAt           DateTime?
  lastReviewDate        DateTime?
  nextReviewDate        DateTime?
  terminatedAt          DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  
  // Relations
  onboarding            VendorOnboarding?
  assessments           VendorAssessment[]
  contracts             VendorContract[]
  issues                VendorIssue[]
  documents             VendorDocument[]
  contacts              VendorContact[]
  assessmentInvitations VendorAssessmentInvitation[]
  requesterTaskLinks    RequesterTaskLink[]
  portalSessions        VendorPortalSession[]
  monitoringRecords     VendorMonitoring[]
  monitoringProfiles    EngagementMonitoringProfile[]
  monitoringSignals     EngagementMonitoringSignal[]
  reviews               VendorReview[]
  
  // Enterprise Audit Relations
  approvalWorkflows     VendorApprovalWorkflow[]
  dueDiligenceScope     VendorDueDiligenceScope?
  riskControls          VendorRiskControl[]
  issueRCAs             VendorIssueRCA[]
  issueEscalations      VendorIssueEscalation[]
  riskHistory           VendorRiskHistory[]
  documentAlerts        VendorDocumentAlert[]
  exceptions            VendorException[]
  socScope              VendorSOCScope?
  fourthPartiesList     FourthParty[]
  exitRiskAssessment    VendorExitRiskAssessment?
  exitClosure           VendorExitClosure?
  businessProcessMappings BusinessProcessVendorMapping[]
  baa                   VendorBAA?
  isoControlMappings    VendorISOControlMapping[]
  intakeMatches         IntakeRequest[]
  engagements           Engagement[]
  
  @@unique([organizationId, publicId])
  @@index([organizationId])
  @@index([tier])
  @@index([status])
  @@index([vendorType])
  @@index([nextReviewDate])
  @@index([organizationId, status])
  @@index([organizationId, tier])
  @@index([organizationId, nextReviewDate])
  @@index([organizationId, domain])
  @@index([status, tier])
  @@index([createdAt])
  @@index([lastReviewDate])
  @@index([businessOwnerUserId])
}

enum VendorOnboardingStage {
  REQUEST
  INTAKE
  TIER_REVIEW
  DUE_DILIGENCE_PLAN
  READY_TO_SEND
  AWAITING_VENDOR
  VENDOR_IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  REMEDIATION
  RISK_ACCEPTANCE
  CONTRACT_REVIEW
  APPROVAL
  ACTIVE
  REASSESSMENT
  OFFBOARDING
}

model VendorOnboarding {
  id                    String                 @id @default(uuid())
  vendor                Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  vendorId              String                 @unique
  organization          Organization           @relation(fields: [organizationId], references: [id])
  organizationId        String
  stage                 VendorOnboardingStage  @default(INTAKE)
  intakeAssessmentId    String?
  intakeDueAt           DateTime?
  intakeStartedAt       DateTime?
  intakeCompletedAt     DateTime?
  intakeAttestedAt      DateTime?
  intakeAttestedBy      String?
  recommendedTier       VendorTier?
  recommendedScore      Int?
  recommendedFactors    Json?
  hardFloors            Json?
  confirmedTier         VendorTier?
  tierConfirmedAt       DateTime?
  tierConfirmedBy       String?
  overrideReason        String?
  previousRecommendedTier VendorTier?
  tierReviewDueAt       DateTime?
  plan                  Json?
  planConfirmedAt       DateTime?
  planConfirmedBy       String?
  assessmentContactId   String?
  invitationId          String?
  dueDiligenceDueAt     DateTime?
  dueDiligenceSentAt    DateTime?
  dueDiligenceSentBy    String?
  vendorActivatedAt     DateTime?
  vendorSubmittedAt     DateTime?
  lastReminderAt        DateTime?
  reminderCount         Int                    @default(0)
  requesterName         String?
  requesterEmail        String?
  engagementPublicId    String?
  iraAnswers            Json?
  iraUnknownCount       Int?
  screeningStatus       String                 @default("CLEAR")
  externalRating        Json?
  contractChecklist     Json?
  contractAttestedAt    DateTime?
  contractAttestedBy    String?
  approvalDecision      String?
  approvalConditions    String?
  approvedAt            DateTime?
  approvedBy            String?
  approvalPreparedBy    String?
  approvalPreparedAt    DateTime?
  approvalPreparedDecision String?
  approvalPreparedRationale String?
  lifecycleActivatedAt  DateTime?
  nextReassessmentAt    DateTime?
  reassessmentFrequencyDays Int?
  lastReassessmentAt    DateTime?
  residualAtApproval    Int?
  engagementId          String?
  engagement            Engagement?            @relation(fields: [engagementId], references: [id])
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@index([organizationId])
  @@index([engagementId])
  @@index([organizationId, stage])
  @@index([intakeDueAt])
  @@index([tierReviewDueAt])
  @@index([dueDiligenceDueAt])
}

enum IntakeSourceChannel {
  SUPREME_FORM
  EMAIL
  SERVICENOW
  JIRA
  PROCUREMENT
  PUBLIC_API
  OTHER
}

enum IntakeStatus {
  SUBMITTED
  UNASSIGNED
  ASSIGNED
  IN_REVIEW
  NEEDS_INFORMATION
  READY_FOR_MATCH
  VENDOR_MATCHED
  ENGAGEMENT_CREATED
  CANCELLED
  REJECTED
  DUPLICATE
}

enum IntakePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum EngagementStatus {
  DRAFT
  INTAKE_COMPLETE
  READY_FOR_IRA
  IRA_IN_PROGRESS
  TIER_REVIEW
  NEEDS_REQUESTER_CLARIFICATION
  INHERENT_TIER_CONFIRMED
  DUE_DILIGENCE_PLANNING
  READY_TO_SEND
  AWAITING_VENDOR
  VENDOR_IN_PROGRESS
  VENDOR_SUBMITTED
  SPECIALIST_REVIEW
  FINDING_REVIEW
  RESIDUAL_READY
  TREATMENT_REVIEW
  ACCEPTANCE_PENDING
  TREATMENT_DECIDED
  CONTRACT_REVIEW
  GATE_BLOCKED
  GATE_APPROVED
  ACTIVE
  AVOIDED
  REJECTED
}

enum EngagementDueDiligencePlanStatus {
  DRAFT
  NEEDS_REVIEW
  CONFIRMED
}

enum EngagementReviewStatus {
  PENDING
  IN_REVIEW
  NEEDS_CLARIFICATION
  COMPLETE
}

enum EngagementControlRating {
  EFFECTIVE
  PARTIALLY_EFFECTIVE
  INEFFECTIVE
  NOT_APPLICABLE
  NOT_ASSESSED
}

enum EngagementResidualStatus {
  NOT_READY
  CALCULATED
  CONFIRMED
}

enum EngagementIraStatus {
  REQUIRED
  IN_PROGRESS
  SUBMITTED
  NEEDS_CLARIFICATION
  TIER_REVIEW
  CONFIRMED
}

model IntakeRequest {
  id                      String              @id @default(uuid())
  publicId                String
  organization            Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationId          String
  requesterUserId         String?
  requesterName           String
  requesterEmail          String
  requesterBusinessUnit   String?
